FROM fedora:41

ARG GO_VERSION=1.26.2
ARG TARGETARCH

RUN dnf install -y ca-certificates curl git tar gzip \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" \
      | tar -xz -C /usr/local \
    && dnf clean all

ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /app
COPY . .

RUN go build -o /usr/local/bin/milliwaysctl ./cmd/milliwaysctl/

CMD ["bash", "tests/smoke/run_smoke.sh", "--no-docker"]
